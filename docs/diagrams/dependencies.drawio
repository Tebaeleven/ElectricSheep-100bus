        <mxCell id="r1" value="&lt;b style=&quot;font-size:19px&quot;&gt;循環なし（DAG）&lt;/b&gt;&lt;br&gt;&lt;br&gt;依存は上から下への一方向だけ。&lt;b&gt;robot が終端&lt;/b&gt;（他の @workspace/* に依存しない）。&lt;b&gt;db → robot&lt;/b&gt; はあるが robot → db は無く、agent ↔ devices のような相互参照も無い。turbo の &lt;code&gt;dependsOn: [&quot;^build&quot;]&lt;/code&gt; がこの順でビルドできる。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="110" width="490" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;catalog で一元管理（pnpm-workspace.yaml）&lt;/b&gt;&lt;br&gt;@ai-sdk/react・@mastra/{ai-sdk,core,libsql,memory,pg}・@supabase/supabase-js・ai・mastra・supabase・tsx・vitest・zod の 14 件を catalog: で pin。各 package.json は &lt;code&gt;&quot;catalog:&quot;&lt;/code&gt; と書くだけでバージョンが揃う。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="224" width="490" height="92" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;実行環境&lt;/b&gt;&lt;br&gt;Node &amp;gt;=22.13（.nvmrc = 22）&lt;br&gt;pnpm 10.34.5&lt;br&gt;Turborepo 2.10.12" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="330" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;リンク方式&lt;/b&gt;&lt;br&gt;ワークスペース間は &lt;code&gt;workspace:*&lt;/code&gt;（pnpm の symlink）。ビルド成果物ではなく TS ソースを直接参照。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=12;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="330" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;client/web/next.config.ts&lt;/b&gt;&lt;br&gt;&lt;code&gt;serverExternalPackages: ['@mastra/*']&lt;/code&gt;（Node ネイティブ依存をバンドルしない）&lt;br&gt;&lt;code&gt;transpilePackages&lt;/code&gt; は 5 パッケージ: @workspace/{ui, agent, robot, db, devices}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#4338CA;fontFamily=Helvetica;fontSize=12;fontColor=#1E1B4B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="412" width="490" height="74" as="geometry" />
        </mxCell>

