        <mxCell id="lg4t" value="物理機器" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="600" y="827" width="120" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="" style="rounded=0;html=1;shadow=0;strokeWidth=1.5;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1">
          <mxGeometry x="60" y="854" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lg5t" value="Web / クライアント" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="80" y="853" width="170" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg6" value="" style="rounded=0;html=1;shadow=0;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1">
