          <mxGeometry x="410" y="828" width="14" height="14" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" value="データ / 品質ゲート" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="1">
