<mxfile host="app.diagrams.net" modified="2026-09-12T00:00:00.000Z" agent="claude-code" version="24.0.0" type="device">
  <diagram id="context-diagram" name="コンテキスト図">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="コンテキスト図 — 機器接続と API エンドポイント詳細" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ElectricSheep-100bus / Next.js 16 を中心とした外部システム・物理機器との接続と全 API エンドポイント（受領日 2026-09-11 の要件定義書と実装ブランチに基づく）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1100" height="22" as="geometry" />
        </mxCell>

        <mxCell id="gemini" value="Google Gemini API（外部サービス）&lt;br&gt;GHOST_MODEL=google/gemini-3.8-flash（Mastra モデルルーター）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=Helvetica;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="440" height="52" as="geometry" />
        </mxCell>

        <mxCell id="rules" value="&lt;b&gt;接続の約束事&lt;/b&gt;&lt;br&gt;・HTTP 機器は http://host:port だけを env に設定し、&lt;b&gt;/api/v1&lt;/b&gt; 接頭辞は SDK が付与（WS も /ws/v1/robot を付与）&lt;br&gt;・WS は &lt;b&gt;request_id&lt;/b&gt;（req-&amp;lt;uuid&amp;gt;）で要求と ack / error / camera.frame を相関させる&lt;br&gt;・画像・音声の base64 は &lt;b&gt;Data URL 接頭辞なし&lt;/b&gt;。ワイヤ形式は snake_case、公開 API は camelCase（変換は SDK 内部）&lt;br&gt;・&lt;font color=&quot;#DC2626&quot;&gt;認証方式は未確定&lt;/font&gt;。DEVICE_AUTH_TOKEN が設定されていれば Authorization: Bearer を全機器に付与（暫定）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="640" height="104" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="&lt;b&gt;ブラウザ（クライアント）&lt;/b&gt;&lt;br&gt;&lt;br&gt;・チャット画面 /（useChat + SSE 受信）&lt;br&gt;・機器パネル components/device-panel.tsx&lt;br&gt;　（レール / スタックちゃん / デスクトップ）&lt;br&gt;・開発者ダッシュボード /dev&lt;br&gt;　（全 17 エンドポイントを手動実行）&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;LAN の機器を直接叩かない&lt;/font&gt;（必ず Route Handler 経由）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#EEF2FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="214" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="nextjs" value="Next.js 16（制御元 / サーバー）&lt;br&gt;Route Handler ＋ Mastra ghost agent（同一プロセス）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FAFAFA;strokeColor=#CBD5E1;fontColor=#0F172A;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="180" width="340" height="480" as="geometry" />
        </mxCell>
        <mxCell id="ep-chat" value="&lt;b&gt;POST /api/chat&lt;/b&gt;&lt;br&gt;handleChatStream({ version: &quot;v7&quot; }) → SSE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="232" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="ep-robot" value="&lt;b&gt;POST /api/robot/command&lt;/b&gt;&lt;br&gt;&lt;b&gt;GET&amp;nbsp; /api/robot/status&lt;/b&gt;&lt;br&gt;@workspace/robot（move/stop/speak/emote/status）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#EEF2FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="296" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ep-devices" value="&lt;b&gt;/api/devices/… 12 本&lt;/b&gt;（@workspace/devices）&lt;br&gt;rail: move(POST) / stop(POST) / status(GET)&lt;br&gt;desktop: screenshot(POST) / browser/open(POST) /&lt;br&gt;　status(GET)&lt;br&gt;stackchan: hand(POST) / camera(POST) /&lt;br&gt;　audio/start(POST) / audio/stop(POST) /&lt;br&gt;　audio/recent(GET) / status(GET)&lt;br&gt;入力は zod で 400、機器エラーは 200 + ok:false" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#EEF2FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="370" width="300" height="212" as="geometry" />
        </mxCell>
        <mxCell id="ep-dev" value="&lt;b&gt;GET /api/dev/env&lt;/b&gt;（秘密値は 設定済み/未設定 のみ）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#EEF2FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="594" width="300" height="44" as="geometry" />
        </mxCell>

        <mxCell id="esp32" value="&lt;b&gt;ESP32（空中レール）&amp;nbsp;&amp;nbsp;HTTP&lt;/b&gt;&lt;br&gt;base: RAIL_BASE_URL（既定 http://127.0.0.1:8791）&lt;br&gt;&lt;br&gt;POST /api/v1/rail/move&lt;br&gt;POST /api/v1/rail/stop&lt;br&gt;GET&amp;nbsp;&amp;nbsp; /api/v1/rail/status" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="196" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="stackchan" value="&lt;b&gt;スタックちゃん（おばけロボット本体）&amp;nbsp;&amp;nbsp;WebSocket&lt;/b&gt;&lt;br&gt;url: STACKCHAN_WS_URL（既定 ws://127.0.0.1:8793）＋ パス /ws/v1/robot&lt;br&gt;&lt;br&gt;&lt;b&gt;送信（Next → 機器）&lt;/b&gt;&lt;br&gt;　hand.set　data: {&quot;state&quot;:&quot;open&quot;|&quot;closed&quot;} → ack&lt;br&gt;　audio.start → ack の後 audio.chunk が継続&lt;br&gt;　audio.stop → ack&lt;br&gt;　camera.capture → camera.frame&lt;br&gt;&lt;b&gt;受信（機器 → Next）&lt;/b&gt;&lt;br&gt;　ack / error（{&quot;code&quot;,&quot;message&quot;}）&lt;br&gt;　audio.chunk（{mime_type, audio_base64, seq}）&lt;br&gt;　camera.frame（{mime_type, image_base64}）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="366" width="400" height="230" as="geometry" />
        </mxCell>
        <mxCell id="electron" value="&lt;b&gt;Electron（デスクトップ）&amp;nbsp;&amp;nbsp;HTTP&lt;/b&gt;&lt;br&gt;base: DESKTOP_BASE_URL（既定 http://127.0.0.1:8792）&lt;br&gt;&lt;br&gt;POST /api/v1/desktop/screenshot&lt;br&gt;POST /api/v1/desktop/browser/open（&lt;font color=&quot;#DC2626&quot;&gt;http/https のみ&lt;/font&gt;）&lt;br&gt;GET&amp;nbsp;&amp;nbsp; /api/v1/desktop/status" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="636" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="branch" value="&lt;b&gt;分岐点 DEVICE_MODE = mock | real&lt;/b&gt;&lt;br&gt;createDevices(process.env)&lt;br&gt;real でも URL 未設定の機器はモック" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;dashed=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="700" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mocks" value="&lt;b&gt;モック機器 3 台&lt;/b&gt;（pnpm devices:mock）&lt;br&gt;レール HTTP&amp;nbsp; :8791&lt;br&gt;デスクトップ HTTP&amp;nbsp; :8792&lt;br&gt;スタックちゃん WS&amp;nbsp; :8793&lt;br&gt;＋ ロボットモック HTTP :8787" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;dashed=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="810" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="supabase" value="&lt;b&gt;Supabase / Postgres（ローカル）&lt;/b&gt;&lt;br&gt;public.robot_commands（コマンド履歴ログ）&lt;br&gt;mastra.*（会話スレッド・メッセージ。PostgresStore が自動作成）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#064E3B;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="820" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="todo" value="&lt;b&gt;未確定事項（要件定義書 §6 TODO）&lt;/b&gt;&lt;br&gt;・各機器の IP アドレス / ポート番号&lt;br&gt;・認証方式（DEVICE_AUTH_TOKEN → Authorization: Bearer は暫定）&lt;br&gt;・レール座標系の原点・可動範囲・軸方向（direction 1 / -1 の向き）・速度&lt;br&gt;・audio.chunk の音声形式（コーデック / サンプリングレート / seq の採番）&lt;br&gt;・ack / error の data スキーマ、rail・desktop status の追加フィールド&lt;br&gt;・複数クライアントからの同時接続を許すか" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#DC2626;fontColor=#7F1D1D;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="810" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Web / クライアント（Next.js・ブラウザ・/dev）&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;■&lt;/font&gt; AI / エージェント（Mastra・/api/chat）&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;■&lt;/font&gt; 外部サービス（Google Gemini API）&lt;br&gt;&lt;font color=&quot;#EA580C&quot;&gt;■&lt;/font&gt; 物理機器（ESP32 / スタックちゃん / Electron）&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;■&lt;/font&gt; データ（Supabase / Postgres）&lt;br&gt;&lt;font color=&quot;#CA8A04&quot;&gt;■&lt;/font&gt; モック / 分岐（破線）&lt;br&gt;― 実線: 同期 HTTP　┄ 破線: WebSocket / ストリーム&lt;br&gt;→ 矢印は要求の向き（双方向は 2 本で表現）&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;赤&lt;/font&gt;: 未確定事項 / 安全上の制約" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FAFAFA;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;出典（読んだファイル）&lt;/b&gt;&lt;br&gt;docs/specs/robot-api-requirements.md&lt;br&gt;packages/devices/src/{wire,schemas,constants}.ts&lt;br&gt;packages/devices/src/http/*, src/ws/stackchan.ts&lt;br&gt;client/web/app/api/chat/route.ts&lt;br&gt;client/web/lib/devices.ts,&lt;br&gt;　app/api/devices/**（12 ルート）&lt;br&gt;client/web/lib/dev/endpoints.ts&lt;br&gt;packages/robot/src/http.ts（DEFAULT_ENDPOINT_MAP）&lt;br&gt;client/web/.env.example" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;strokeWidth=1.5;fillColor=#FAFAFA;strokeColor=#CBD5E1;fontColor=#334155;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="e-browser-chat" value="HTTP POST /api/chat&lt;br&gt;← SSE で逐次受信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="ep-chat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-browser-devices" value="HTTP POST/GET&lt;br&gt;/api/devices/…&lt;br&gt;例 {&quot;state&quot;:&quot;open&quot;}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="ep-devices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-gemini" value="HTTPS（Mastra モデルルーター）&lt;br&gt;会話生成・tool 呼び出しの判断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep-chat" target="gemini">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-26" /></mxGeometry>
        </mxCell>

        <mxCell id="e-rail" value="HTTP 同期（Next → ESP32）&lt;br&gt;POST /api/v1/rail/move&lt;br&gt;{&quot;axis&quot;:&quot;x&quot;,&quot;direction&quot;:1,&quot;duration_ms&quot;:500}&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;move は再送禁止 / duration_ms ≦ 3000&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.06;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep-devices" target="esp32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-ws-out" value="WebSocket 送信（Next → 機器）&lt;br&gt;{&quot;type&quot;:&quot;hand.set&quot;,&quot;request_id&quot;:&quot;req-001&quot;,&quot;data&quot;:{…}}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep-devices" target="stackchan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ws-in" value="WebSocket 受信（機器 → Next）&lt;br&gt;ack / error / audio.chunk / camera.frame&lt;br&gt;request_id で要求と相関" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="stackchan" target="ep-devices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-electron" value="HTTP 同期（Next → Electron）&lt;br&gt;POST /api/v1/desktop/screenshot&lt;br&gt;→ {&quot;mime_type&quot;:&quot;image/png&quot;,&quot;image_base64&quot;:&quot;…&quot;}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.97;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep-devices" target="electron">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-db-sql" value="SQL / postgres:54322&lt;br&gt;Mastra PostgresStore が&lt;br&gt;mastra.* を読み書き" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nextjs" target="supabase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-db-rest" value="HTTP / PostgREST:54321&lt;br&gt;insert public.robot_commands&lt;br&gt;{command, status, result}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#475569;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="nextjs" target="supabase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-branch" value="機器クライアント生成&lt;br&gt;（lib/devices.ts のシングルトン）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#475569;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nextjs" target="branch">
          <mxGeometry x="-0.45" relative="1" as="geometry"><mxPoint as="offset" x="-10" y="-16" /></mxGeometry>
        </mxCell>
        <mxCell id="e-mock" value="DEVICE_MODE=mock のとき&lt;br&gt;モックへ差し替え（実機不要）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#CA8A04;dashed=1;dashPattern=8 4;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="branch" target="mocks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
