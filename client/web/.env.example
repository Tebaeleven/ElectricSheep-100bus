# Google Gemini API キー（おばけエージェントの LLM 呼び出しに必要）
# 取得: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# 会話に使うモデル（Mastra v1 のモデルルーター文字列）
# 候補: google/gemini-3.8-flash（既定・速度重視） / google/gemini-3.1-pro-preview / google/gemini-2.5-flash
GHOST_MODEL=google/gemini-3.8-flash

# ロボット接続モード: mock | http
ROBOT_MODE=mock

# 実機ロボットの HTTP ベース URL（ROBOT_MODE=http のとき使用）
ROBOT_BASE_URL=http://127.0.0.1:8787

# ロボットモックサーバーの待ち受けポート（既定 8787）
ROBOT_MOCK_PORT=8787

# Mastra Memory の保存先 Postgres。以下は Supabase ローカルの既定値（`supabase start` が生成）。未設定なら in-memory にフォールバック
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase ローカル API
SUPABASE_URL=http://127.0.0.1:54321

# Supabase の secret key（サーバー専用）。未設定なら robot_commands ログはスキップ
SUPABASE_SECRET_KEY=

# 機器 API の接続モード: mock | real
DEVICE_MODE=mock

# レール（ESP32）の HTTP ベース URL
RAIL_BASE_URL=http://127.0.0.1:8791

# デスクトップの HTTP ベース URL。接続先でポートが変わる（台帳: scripts/ports.json）
#   モック（pnpm devices:mock）   → http://127.0.0.1:8792
#   実機 Electron（client/desktop） → http://127.0.0.1:8801
# 既定はモック。実機に繋ぐときは 8801 に書き換える（実機の起動手順は docs/runbooks/desktop.md）
DESKTOP_BASE_URL=http://127.0.0.1:8792

# スタックちゃん B 方式（推奨）: PC 側ブリッジの HTTP ベース URL
# `pnpm stackchan:bridge` で 8030 に起動する。機器はここへ WS で繋いでくる
# DEVICE_MODE=real のとき、この値があれば旧契約の STACKCHAN_WS_URL より優先される
STACKCHAN_BRIDGE_URL=http://127.0.0.1:8030

# スタックちゃん（旧契約）の WebSocket URL。現行ファームは /ws/v1/robot を実装していない
STACKCHAN_WS_URL=ws://127.0.0.1:8793

# 機器 API の認証トークン（空なら認証ヘッダーを送らない）
DEVICE_AUTH_TOKEN=

# レール駆動時間の上限（ミリ秒・安全上限）
DEVICE_RAIL_MAX_DURATION_MS=3000

# 機器呼び出しのタイムアウト（ミリ秒）
DEVICE_TIMEOUT_MS=5000
