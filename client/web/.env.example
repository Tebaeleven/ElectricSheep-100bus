# Anthropic API キー（おばけエージェントの LLM 呼び出しに必要）
ANTHROPIC_API_KEY=

# 会話に使うモデル（Mastra v1 のモデル文字列）
GHOST_MODEL=anthropic/claude-sonnet-5

# ロボット接続モード: mock | http
ROBOT_MODE=mock

# 実機ロボットの HTTP ベース URL（ROBOT_MODE=http のとき使用）
ROBOT_BASE_URL=http://127.0.0.1:8787

# ロボットモックサーバーの待ち受けポート（既定 8787）
ROBOT_MOCK_PORT=8787

# Mastra Memory の保存先 Postgres（ローカル Supabase）。未設定なら in-memory にフォールバック
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase ローカル API
SUPABASE_URL=http://127.0.0.1:54321

# Supabase の secret key（サーバー専用）。未設定なら robot_commands ログはスキップ
SUPABASE_SECRET_KEY=
