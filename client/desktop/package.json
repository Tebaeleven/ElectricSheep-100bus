{
  "name": "ghost-companion",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "electron": "node electron/launch.js",
    "electron:stop": "node electron/with-node22.js electron/stop.js",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "dev:pet": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "dist": "node electron/dist.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "jimp": "^1.6.1",
    "next": "15.5.24",
    "pdfkit": "^0.20.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "sharp": "^0.34.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "bas.100.ghost-companion",
    "productName": "Ghost Companion",
    "files": ["electron/**/*", "package.json"],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "zip", "arch": ["arm64"] }],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }]
    },
    "linux": {
      "category": "Utility",
      "target": [{ "target": "zip", "arch": ["x64"] }]
    }
  }
}
