# Petassist / Ghost Companion

# Optional OpenAI (Finder overlay / fallback — TrueForge is primary harness)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# TrueForge harness (npx @truefoundry/trueforge)
# TRUEFORGE_BASE_URL=http://127.0.0.1:8790
# TRUEFORGE_TOKEN=
# TRUEFORGE_MODEL=

# Optional ElevenLabs TTS for ghost care voice
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Electron / site
# GHOST_COMPANION_URL=http://127.0.0.1:3000
# PETASSIST_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Desktop API（Next の @workspace/devices から叩くローカル HTTP サーバー）
# 127.0.0.1 固定で待ち受ける。使用中なら +1 して実際のポートを起動ログと
# GET /api/v1/desktop/status に出す
# DESKTOP_API_PORT=8792
