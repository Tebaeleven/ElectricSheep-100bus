# Petassist / Ghost Companion

# Optional OpenAI (Finder overlay / fallback — TrueForge is primary harness)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# TrueForge harness (npx @truefoundry/trueforge)
# TRUEFORGE_BASE_URL=http://127.0.0.1:8790
# TRUEFORGE_TOKEN=
# TRUEFORGE_MODEL=

# Optional ElevenLabs TTS for ghost care voice
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Next（このアプリの UI）の待ち受けポート。client/web の 3000 と衝突しないよう既定 3100。
# `pnpm run dev` と `electron/wait-for-desk.js` / `electron/main.js` が同じ値を見る
DESKTOP_NEXT_PORT=3100

# Electron / site
# GHOST_COMPANION_URL=http://127.0.0.1:3100
# PETASSIST_URL=http://127.0.0.1:3100
# NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Desktop API（Next の @workspace/devices から叩くローカル HTTP サーバー）
# 127.0.0.1 固定で待ち受ける。モック機器（8791-8793）と分けるため既定は 8801。
# 使用中でもポートはずらさず、警告を出して API だけ無効にする（pnpm ports:check で確認）
DESKTOP_API_PORT=8801
