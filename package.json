{
  "name": "electricsheep-100bus",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "turbo format",
    "verify": "turbo run lint typecheck test build",
    "db:start": "supabase --workdir server start",
    "db:stop": "supabase --workdir server stop",
    "db:reset": "supabase --workdir server db reset",
    "db:status": "supabase --workdir server status",
    "db:types": "supabase --workdir server gen types typescript --local > packages/db/src/database.types.ts",
    "agent:studio": "pnpm --filter @workspace/agent dev",
    "robot:mock": "pnpm --filter @workspace/robot mock",
    "devices:mock": "pnpm --filter @workspace/devices mock",
    "wt": "bash scripts/wt-setup.sh"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "catalog:",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  }
}
